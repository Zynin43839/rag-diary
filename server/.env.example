# RAG-Diary server environment (example)
# Copy to `.env` and fill in your own values. Never commit `.env`.

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon/publishable key. Used on purpose so Row Level Security stays enforced.
SUPABASE_ANON_KEY=your-anon-key

# Database connection string, used only by `bun run apply:schema`
# (Project Settings -> Database -> Connection string -> URI, include the password)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Google AI Studio key (chat, summaries, embeddings, images)
GEMINI_API_KEY=your-google-ai-studio-key
# Optional overrides
# AI_CHAT_MODEL=gemini-3.5-flash
# AI_EMBED_MODEL=gemini-embedding-001
# AI_EMBED_DIM=1536
# AI_IMAGE_MODEL=gemini-3.1-flash-image

# Browser origin allowed by CORS (comma-separated list for more than one)
FRONTEND_ORIGIN=http://localhost:3000
